# Copie para .env.local e ajuste os valores

# MongoDB (local em dev, MongoDB Atlas em produção)
MONGODB_URI=mongodb://localhost:27017/velora

# Segredo para assinatura dos JWTs de sessão (gere um valor longo e aleatório)
AUTH_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# URL base pública (usada para montar links do portal da família e webhook de pagamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MisticPay (gateway PIX para assinatura de planos) — https://docs.misticpay.com/
MISTICPAY_CLIENT_ID=
MISTICPAY_CLIENT_SECRET=
